{
  "name": "aurapet-desktop",
  "version": "1.5.1",
  "description": "Cross-platform AI Desktop Pet & Companion (ChatGPT-style floating assistant)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "ai-companion",
    "chatgpt",
    "cross-platform"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.antigravity.aurapet",
    "productName": "AuraPet",
    "files": [
      "**/*",
      "!renderer/models/pet.glb",
      "!tools/**",
      "!dist/**",
      "!dist-new/**",
      "!**/*.log"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
